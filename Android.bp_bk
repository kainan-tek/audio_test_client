// Audio Test Client - Android Build Configuration
// This file is the Soong build equivalent of Android.mk

// Default configuration (shared by all variants below)
cc_defaults {
    name: "audio_test_client_defaults",

    // C++ standard
    cppflags: [
        "-std=c++17",
        "-fexceptions",
    ],

    // Compiler flags
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
        "-Wno-unused-parameter",
    ],

    // Shared library dependencies
    shared_libs: [
        "libutils",
        "libcutils",
        "liblog",
        "libmedia",
        "libhardware",
        "libbinder",
        "libaudioclient",
        "libmedia_helper",
    ],

    // Header library dependencies
    header_libs: [
        "libmedia_headers",
        "libmediametrics_headers",
        "libmedia_helper_headers",
    ],
}

// Main binary for Android 16+ ONLY (both macros hard-coded; Soong cannot read
// PLATFORM_VERSION like Android.mk does). For Android 13-15, build with Android.mk.
// Android 13+ replaced the AudioRecord/AudioTrack callback (callback_t + void* user) with wp<IAudioTrackCallback>
// Android 16+ renamed AudioTrack::getRoutedDeviceId() to getRoutedDeviceIds()
cc_binary {
    name: "audio_test_client",
    defaults: ["audio_test_client_defaults"],
    srcs: ["audio_test_client.cpp"],

    cflags: [
        "-DANDROID_API_13_PLUS",
        "-DANDROID_API_16_PLUS",
    ],
}

// Optional: Binary for older Android versions (if needed)
// Uncomment this section if you need to support Android 12L and below
/*
cc_binary {
    name: "audio_test_client_legacy",
    defaults: ["audio_test_client_defaults"],
    srcs: ["audio_test_client.cpp"],

    // No ANDROID_API_13_PLUS flag for legacy versions
}
*/
